# 运行时日志 / V8 report / 看门狗日记（按天轮转，不入库）
logs/
# 例外：app/logs（统一日志服务）与 tests/unit/logs（测试）是源码，须入库
!app/logs/
!tests/unit/logs/
reference/hotupdate/textasset-names.json

# 会话内存 / 运行时订单
.workbuddy/
data/pay/
# 运行时 mod 缓存（占位 .placeholder 保留）
mods/android/*.dat
mods/windows/*.dat
# 运行时提取的明文 Lua 参考资产（extract:lua / extract:lua:hot 产物）——方括号须转义，否则被当 glob 字符类
data/\[uc\]lua/
# 运行时用户上传的像素画数据（arkhub 存档），不入库
data/arkhub/pixels/
# 运行时用户画廊图片（gallery 存档），不入库
data/user/gallery/
# T3 目录重组：根 player_data.json 归档（未跟踪本地产物，勿提交）
data/player_data.json.root-backup
# 私服验签密钥（sign:key 生成；私钥绝不入库）
data/crypto/
# 插件运行时状态与客户端日志回传（config.json 为本地启停/选项状态，logs 为 Unity 日志落盘）
data/plugin/

# Python 字节码缓存（调试脚本用）
__pycache__/
*.pyc
